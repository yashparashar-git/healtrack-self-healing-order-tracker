PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
NODE_ENV=development

# Chaos Lab (development only, localhost only). Disabled unless "true".
ENABLE_CHAOS_LAB=true
# Optional shared secret; when set, Chaos Lab POSTs need header x-chaos-token.
# CHAOS_TOKEN=

# Process-crash scenario: also requires running under PM2 (npm run pm2:start).
ENABLE_CRASH_DEMO=true
